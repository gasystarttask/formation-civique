# Avis de fin de thématique (Upstash Redis, via Vercel Marketplace).
# L'intégration Vercel crée KV_REST_API_URL / KV_REST_API_TOKEN : les deux noms sont acceptés.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Plafond mensuel d'avis enregistrés (2 commandes Redis par avis).
# 150000 avis = 300000 commandes, sous les 500000 commandes/mois de l'offre gratuite Upstash.
FEEDBACK_MONTHLY_LIMIT=150000
